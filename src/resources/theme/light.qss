/* ngPost-2026 light theme (clean, Windows 11 inspired).
   Applied at startup on top of the Fusion style, see NgPost::applyTheme().
   Colours: window #f3f3f3, cards #ffffff, text #1b1b1b, accent #0067c0 */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "Noto Sans", "Helvetica Neue", Arial, sans-serif;
}

QMainWindow, QDialog {
    background: #f3f3f3;
}

QLabel {
    color: #1b1b1b;
    background: transparent;
}

QToolTip {
    background: #ffffff;
    color: #1b1b1b;
    border: 1px solid #d1d1d1;
    padding: 4px 6px;
}

/* ---------- cards ---------- */
QGroupBox {
    background: #ffffff;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 6px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px 0 6px;
    color: #1b1b1b;
}

/* ---------- buttons ---------- */
QPushButton {
    background: #fdfdfd;
    color: #1b1b1b;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton:hover {
    background: #f3f3f3;
    border-color: #c4c4c4;
}
QPushButton:pressed {
    background: #e9e9e9;
    color: #5f5f5f;
}
QPushButton:disabled {
    background: #f6f6f6;
    color: #a0a0a0;
    border-color: #e6e6e6;
}
QPushButton:default {
    background: #0067c0;
    color: #ffffff;
    border: 1px solid #0067c0;
}
QPushButton:default:hover {
    background: #1975c5;
}
QPushButton:default:pressed {
    background: #3a87ca;
}

/* ---------- text inputs and lists ---------- */
QLineEdit {
    background: #ffffff;
    color: #1b1b1b;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #0067c0;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border-bottom: 2px solid #0067c0;
}
QLineEdit:disabled {
    background: #f6f6f6;
    color: #a0a0a0;
}

QTextEdit, QPlainTextEdit, QListWidget, QTableWidget {
    background: #ffffff;
    color: #1b1b1b;
    border: 1px solid #e3e3e3;
    border-radius: 6px;
    selection-background-color: #cce4f7;
    selection-color: #1b1b1b;
}
QListWidget::item {
    padding: 3px 4px;
}
QTableWidget {
    gridline-color: #ececec;
}
QHeaderView::section {
    background: #f6f6f6;
    color: #1b1b1b;
    border: none;
    border-bottom: 1px solid #e3e3e3;
    padding: 4px 6px;
    font-weight: 600;
}

QCheckBox {
    color: #1b1b1b;
    spacing: 6px;
}
QCheckBox:disabled {
    color: #a0a0a0;
}

/* ---------- progress bar ---------- */
QProgressBar {
    background: #e6e6e6;
    color: #1b1b1b;
    border: none;
    border-radius: 5px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk {
    background: #60a5e6;
    border-radius: 5px;
}

/* ---------- tabs ---------- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #e3e3e3;
}
QTabWidget::tab-bar {
    left: 6px;
}
QTabBar::tab {
    background: transparent;
    color: #5f5f5f;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
    margin-right: 2px;
    min-width: 8ex;
}
QTabBar::tab:hover:!selected {
    background: #e9e9e9;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    color: #1b1b1b;
    border-bottom: 2px solid #0067c0;
}
QTabBar::scroller {
    width: 40px;
}
QTabBar QToolButton {
    background: transparent;
    border: none;
}
QTabBar QToolButton::right-arrow {
    image: url(:/icons/right.png);
}
QTabBar QToolButton::left-arrow {
    image: url(:/icons/left.png);
}

/* ---------- scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c3c3c3;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #9e9e9e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c3c3c3;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #9e9e9e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
